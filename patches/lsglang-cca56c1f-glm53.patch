diff --git a/python/sglang/kernels/ops/layernorm/mhc_sm120_triton.py b/python/sglang/kernels/ops/layernorm/mhc_sm120_triton.py
new file mode 100644
index 0000000000..95aabe854e
--- /dev/null
+++ b/python/sglang/kernels/ops/layernorm/mhc_sm120_triton.py
@@ -0,0 +1,149 @@
+"""Fused Triton tail for mhc_pre, for SM120 where the TileLang path cannot build.
+
+The torch reference runs the post-GEMM part as ~50 separate kernels, 40 of them
+the Sinkhorn loop operating on an (s, n, n) tensor of 96 floats. This collapses
+everything after F.linear into one kernel: one program per row, the n*n block
+held in registers for the whole Sinkhorn loop.
+
+The GEMM itself stays in cuBLAS -- it is memory bound on hc_fn and fusing it
+buys nothing.
+"""
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _mhc_pre_tail_kernel(
+    mixes_ptr, rsqrt_ptr, scale_ptr, base_ptr,
+    pre_ptr, post_ptr, comb_ptr,
+    n_rows, mixes_stride,
+    hc_pre_eps, hc_sinkhorn_eps, hc_post_mult,
+    SINKHORN: tl.constexpr, N: tl.constexpr,
+):
+    row = tl.program_id(0)
+    if row >= n_rows:
+        return
+
+    r = tl.load(rsqrt_ptr + row)
+    offs = tl.arange(0, N)
+    base_off = row * mixes_stride
+
+    sc0 = tl.load(scale_ptr + 0)
+    sc1 = tl.load(scale_ptr + 1)
+    sc2 = tl.load(scale_ptr + 2)
+
+    pre_raw = tl.load(mixes_ptr + base_off + offs) * r
+    post_raw = tl.load(mixes_ptr + base_off + N + offs) * r
+    pre_base = tl.load(base_ptr + offs)
+    post_base = tl.load(base_ptr + N + offs)
+
+    pre = tl.sigmoid(pre_raw * sc0 + pre_base) + hc_pre_eps
+    post = hc_post_mult * tl.sigmoid(post_raw * sc1 + post_base)
+
+    ij = offs[:, None] * N + offs[None, :]
+    comb = tl.load(mixes_ptr + base_off + 2 * N + ij) * r
+    comb = comb * sc2 + tl.load(base_ptr + 2 * N + ij)
+
+    # softmax over the last dim
+    mx = tl.max(comb, axis=1)[:, None]
+    e = tl.exp(comb - mx)
+    comb = e / tl.sum(e, axis=1)[:, None]
+    comb = comb + hc_sinkhorn_eps
+
+    # Sinkhorn: the whole loop stays in registers
+    comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_sinkhorn_eps)
+    for _ in tl.static_range(SINKHORN - 1):
+        comb = comb / (tl.sum(comb, axis=1)[:, None] + hc_sinkhorn_eps)
+        comb = comb / (tl.sum(comb, axis=0)[None, :] + hc_sinkhorn_eps)
+
+    tl.store(pre_ptr + row * N + offs, pre)
+    tl.store(post_ptr + row * N + offs, post)
+    tl.store(comb_ptr + row * N * N + ij, comb)
+
+
+def mhc_pre_triton(residual, fn, hc_scale, hc_base, rms_eps, hc_pre_eps,
+                   hc_sinkhorn_eps, hc_post_mult_value, sinkhorn_repeat):
+    """Drop-in replacement for _mhc_pre_torch. residual: (s, n, h)."""
+    s, n, h = residual.shape
+    assert n & (n - 1) == 0, f"n must be a power of two for the fused kernel, got {n}"
+    dtype = residual.dtype
+
+    x_flat = residual.view(s, n * h).float()
+    rsqrt = torch.rsqrt(x_flat.square().mean(-1, keepdim=True) + rms_eps)
+    mixes = torch.nn.functional.linear(x_flat, fn)      # (s, 2n + n*n), no *rsqrt yet
+
+    pre = torch.empty((s, n), device=residual.device, dtype=torch.float32)
+    post = torch.empty((s, n), device=residual.device, dtype=torch.float32)
+    comb = torch.empty((s, n, n), device=residual.device, dtype=torch.float32)
+
+    _mhc_pre_tail_kernel[(s,)](
+        mixes, rsqrt, hc_scale, hc_base,
+        pre, post, comb,
+        s, mixes.stride(0),
+        hc_pre_eps, hc_sinkhorn_eps, hc_post_mult_value,
+        SINKHORN=sinkhorn_repeat, N=n,
+        num_warps=1,
+    )
+
+    layer_input = (pre.unsqueeze(-1) * residual.float()).sum(dim=1).to(dtype)
+    return post.unsqueeze(-1), comb, layer_input
+
+
+@triton.jit
+def _mhc_post_kernel(
+    x_ptr, res_ptr, post_ptr, comb_ptr, out_ptr,
+    n_tok, H,
+    BLOCK_H: tl.constexpr, N: tl.constexpr,
+):
+    """out[s,b,h] = post[s,b]*x[s,h] + sum_a comb[s,a,b]*residual[s,a,h]
+
+    The torch reference materialises an (s, n, n, h) outer product before the
+    reduction; here the n*n mixing matrix stays in registers and each program
+    streams one BLOCK_H slice of one token.
+    """
+    s = tl.program_id(0)
+    hb = tl.program_id(1)
+    if s >= n_tok:
+        return
+
+    offs_h = hb * BLOCK_H + tl.arange(0, BLOCK_H)
+    mask_h = offs_h < H
+    offs_n = tl.arange(0, N)
+
+    xv = tl.load(x_ptr + s * H + offs_h, mask=mask_h, other=0.0).to(tl.float32)
+    post = tl.load(post_ptr + s * N + offs_n).to(tl.float32)          # (N,)
+    comb = tl.load(comb_ptr + s * N * N + offs_n[:, None] * N + offs_n[None, :]).to(tl.float32)
+
+    # residual rows for this token: (N, BLOCK_H)
+    res = tl.load(
+        res_ptr + s * N * H + offs_n[:, None] * H + offs_h[None, :],
+        mask=mask_h[None, :], other=0.0,
+    ).to(tl.float32)
+
+    # out[b, :] = post[b] * x + sum_a comb[a, b] * res[a, :]
+    acc = tl.sum(comb[:, :, None] * res[:, None, :], axis=0)          # (N, BLOCK_H)
+    acc = acc + post[:, None] * xv[None, :]
+
+    tl.store(
+        out_ptr + s * N * H + offs_n[:, None] * H + offs_h[None, :],
+        acc.to(out_ptr.dtype.element_ty),
+        mask=mask_h[None, :],
+    )
+
+
+def mhc_post_triton(x, residual, post_layer_mix, comb_res_mix, hc_mult):
+    """Drop-in for _mhc_post_torch. x:(s,h) residual:(s,n,h) -> (s,n,h)."""
+    s, h = x.shape
+    n = hc_mult
+    assert n & (n - 1) == 0, f"n must be a power of two, got {n}"
+    out = torch.empty((s, n, h), device=x.device, dtype=x.dtype)
+    if s == 0:
+        return out
+    BLOCK_H = 512
+    grid = (s, triton.cdiv(h, BLOCK_H))
+    _mhc_post_kernel[grid](
+        x, residual, post_layer_mix, comb_res_mix, out,
+        s, h, BLOCK_H=BLOCK_H, N=n, num_warps=4,
+    )
+    return out
