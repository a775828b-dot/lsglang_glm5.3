+"""Unit tests for HiSparse DSA pool kpool-compression argument passthrough."""
+
+import unittest
+from unittest.mock import patch
+
+import torch
+
+from sglang.srt.mem_cache.hisparse_memory_pool import HiSparseDSATokenToKVPool
+from sglang.test.ci.ci_register import register_cpu_ci
+from sglang.test.test_utils import CustomTestCase
+
+register_cpu_ci(est_time=2, suite="base-a-test-cpu")
+
+
+class TestHiSparseDSAKpoolArgs(CustomTestCase):
+    def test_constructor_forwards_kpool_compression_args(self):
+        """HiSparse DSA pools must accept and forward the kpool-compression
+        knobs the kv-cache configurator always supplies for DSA models, so
+        ``--enable-hisparse`` plus a DSA/GLM-5.x model cannot hit a TypeError
+        and HiSparse pools can participate in kpool compression and
+        index-layer elision."""
+        seen = {}
+
+        def fake_init(self, **kwargs):
+            seen.update(kwargs)
+            self.kv_cache_dim = kwargs["kv_cache_dim"]
+            self.dtype = kwargs["dtype"]
+
+        with patch(
+            "sglang.srt.mem_cache.hisparse_memory_pool.DSATokenToKVPool.__init__",
+            fake_init,
+        ):
+            HiSparseDSATokenToKVPool(
+                size=1024,
+                page_size=64,
+                kv_lora_rank=512,
+                dtype=torch.uint8,
+                qk_rope_head_dim=64,
+                layer_num=2,
+                device="cpu",
+                index_head_dim=128,
+                enable_memory_saver=False,
+                kv_cache_dim=640,
+                index_kpool=4,
+                index_kpool_compress=True,
+                tail_extra_slots=8,
+                max_running_requests=4,
+                skip_topk_layers=[False, True],
+            )
+        self.assertEqual(seen["index_kpool"], 4)
+        self.assertTrue(seen["index_kpool_compress"])
+        self.assertEqual(seen["tail_extra_slots"], 8)
+        self.assertEqual(seen["max_running_requests"], 4)
+        self.assertEqual(seen["skip_topk_layers"], [False, True])
+        self.assertEqual(seen["index_buf_size"], 1024 * 2)
+
+    def test_defaults_when_omitted(self):
+        seen = {}
+
+        def fake_init(self, **kwargs):
+            seen.update(kwargs)
+            self.kv_cache_dim = kwargs["kv_cache_dim"]
+            self.dtype = kwargs["dtype"]
+
+        with patch(
+            "sglang.srt.mem_cache.hisparse_memory_pool.DSATokenToKVPool.__init__",
+            fake_init,
+        ):
+            HiSparseDSATokenToKVPool(
+                size=1024,
+                page_size=64,
+                kv_lora_rank=512,
+                dtype=torch.uint8,
+                qk_rope_head_dim=64,
+                layer_num=2,
+                device="cpu",
+                index_head_dim=128,
+                enable_memory_saver=False,
+                kv_cache_dim=640,
+            )
+        self.assertEqual(seen["index_kpool"], 1)
+        self.assertFalse(seen["index_kpool_compress"])
+        self.assertEqual(seen["tail_extra_slots"], 0)
+        self.assertIsNone(seen["max_running_requests"])
+        self.assertIsNone(seen["skip_topk_layers"])
+
+
+if __name__ == "__main__":
+    unittest.main()
