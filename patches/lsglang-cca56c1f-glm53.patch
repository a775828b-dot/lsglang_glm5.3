+def _glm5next_smart_resize_canvas(
+    height, width, *, temporal_factor, factor, min_pixels, max_pixels
+):
+    """GLM5Next smart_resize replica (HF Glm5NextImageProcessor).
+
+    ``min_pixels``/``max_pixels`` are the token budgets (min/max_image_tokens);
+    they are scaled by the per-token pixel count inside, matching the HF
+    implementation.
+    """
+
+    def align(value):
+        return math.ceil(value / factor) * factor
+
+    pixels_per_token = temporal_factor * factor**2
+    min_pixels *= pixels_per_token
+    max_pixels *= pixels_per_token
+
+    def fit_within_budget(aligned_frames):
+        low, high = 1, height
+        best_height, best_width = factor, factor
+        while low <= high:
+            content_height = (low + high) // 2
+            content_width = max(1, math.floor(width * content_height / height))
+            candidate_height = align(content_height)
+            candidate_width = align(content_width)
+            if aligned_frames * candidate_height * candidate_width <= max_pixels:
+                best_height, best_width = candidate_height, candidate_width
+                low = content_height + 1
+            else:
+                high = content_height - 1
+        return best_height, best_width
+
+    aligned_frames = max(
+        temporal_factor, round(1 / temporal_factor) * temporal_factor
+    )
+    aligned_height = align(height)
+    aligned_width = align(width)
+    aligned_budget = aligned_frames * aligned_height * aligned_width
+
+    # Scale up tiny images to reach the minimum token budget.
+    if aligned_budget < min_pixels:
+        scale = math.sqrt(min_pixels / (height * width))
+        aligned_height = align(max(1, math.ceil(height * scale)))
+        aligned_width = align(max(1, math.ceil(width * scale)))
+        aligned_budget = aligned_frames * aligned_height * aligned_width
+
+    # Shrink oversized images into the maximum token budget.
+    if aligned_budget > max_pixels:
+        aligned_height, aligned_width = fit_within_budget(aligned_frames)
+
+    return aligned_height, aligned_width
+
+
+class Glm5NextImageProcessor(Glm4vImageProcessor):
+    """Native GLM5Next image preprocessing.
+
+    transformers has no Glm5NextImageProcessor, so AutoProcessor resolves to a
+    plain tokenizer that silently drops ``images=`` kwargs. Preprocess images
+    here (replicating the HF Glm5NextImageProcessor: smart_resize canvas,
+    CLIP normalize, merge-aware patchify) and expand the single <|image|>
+    placeholder token emitted by the chat template into the number of vision
+    tower features, so the encoder output is not truncated by
+    ``_adjust_embedding_length``.
+    """
+
+    models = [
+        m
+        for m in [
+            Glm5NextForConditionalGeneration,
+            Glm5NextForConditionalGenerationNextN,
+        ]
+        if m is not None
+    ]
+
+    def __init__(self, hf_config, server_args, _processor, *args, **kwargs):
+        super().__init__(hf_config, server_args, _processor, *args, **kwargs)
+
+        vc = getattr(hf_config, "vision_config", None)
+        self.patch_size = getattr(vc, "patch_size", 14)
+        self.temporal_patch_size = getattr(vc, "temporal_patch_size", 2)
+        self.merge_size = getattr(vc, "spatial_merge_size", 2)
+        self.image_mean = list(getattr(vc, "image_mean", None) or OPENAI_CLIP_MEAN)
+        self.image_std = list(getattr(vc, "image_std", None) or OPENAI_CLIP_STD)
+
+        # Token budgets come from the checkpoint's processor config, defaulting
+        # to the HF Glm5NextImageProcessor values.
+        self.min_image_tokens = 16
+        self.max_image_tokens = 8000
+        try:
+            import os
+
+            proc_cfg_path = os.path.join(server_args.model_path, "processor_config.json")
+            with open(proc_cfg_path) as f:
+                iproc_cfg = json.load(f).get("image_processor", {})
+            if iproc_cfg.get("image_mean") is not None:
+                self.image_mean = list(iproc_cfg["image_mean"])
+            if iproc_cfg.get("image_std") is not None:
+                self.image_std = list(iproc_cfg["image_std"])
+            if iproc_cfg.get("min_image_tokens") is not None:
+                self.min_image_tokens = int(iproc_cfg["min_image_tokens"])
+            if iproc_cfg.get("max_image_tokens") is not None:
+                self.max_image_tokens = int(iproc_cfg["max_image_tokens"])
+        except (FileNotFoundError, OSError, ValueError, json.JSONDecodeError):
+            pass
+
+    def _preprocess_image(self, pil_image):
+        """Return (pixel_values (num_patches, C*T*P*P), [1, grid_h, grid_w])."""
+        from torchvision.transforms.v2 import functional as tvF
+
+        # GPU (nvJPEG) decode returns a CUDA tensor for strict JPEGs while every
+        # other encoding falls back to a CPU PIL image. Keep this native
+        # preprocessing CPU-uniform so a request mixing both decode paths never
+        # concatenates CUDA and CPU pixel blocks.
+        if isinstance(pil_image, torch.Tensor):
+            pil_image = (
+                pil_image.detach().to("cpu") if pil_image.is_cuda else pil_image
+            )
+
+        pixels_per_token = self.temporal_patch_size * self.patch_size**2
+        factor = self.patch_size * self.merge_size
+        min_pixels = self.min_image_tokens * pixels_per_token
+        max_pixels = self.max_image_tokens * pixels_per_token
+
+        img = tvF.to_image(pil_image)
+        img = img.to(torch.float32) / 255.0
+        height, width = img.shape[-2:]
+
+        target_h, target_w = _glm5next_smart_resize_canvas(
+            height,
+            width,
+            temporal_factor=self.temporal_patch_size,
+            factor=factor,
+            min_pixels=self.min_image_tokens,
+            max_pixels=self.max_image_tokens,
+        )
+        scale = min(target_h / height, target_w / width)
+        if self.temporal_patch_size * height * width >= pixels_per_token * self.min_image_tokens:
+            scale = min(1.0, scale)
+        content_h = max(1, min(target_h, math.floor(height * scale)))
+        content_w = max(1, min(target_w, math.floor(width * scale)))
+        if (content_h, content_w) != (height, width):
+            img = tvF.resize(
+                img,
+                [content_h, content_w],
+                interpolation=tvF.InterpolationMode.BICUBIC,
+                antialias=True,
+            )
+        img = tvF.pad(
+            img, [0, 0, target_w - content_w, target_h - content_h], fill=0.0
+        )
+
+        mean = torch.tensor(
+            self.image_mean, dtype=img.dtype, device=img.device
+        ).view(-1, 1, 1)
+        std = torch.tensor(
+            self.image_std, dtype=img.dtype, device=img.device
+        ).view(-1, 1, 1)
+        img = (img - mean) / std
+
+        # Merge-aware patchify, matching the HF layout exactly: each output row
+        # is one (merge, merge) block flattened as (C, T, P, P) -- channel
+        # outermost, then temporal, then spatial -- which is the layout the
+        # Conv3d patch embed expects.
+        channel, gh, gw = img.shape[0], img.shape[1] // self.patch_size, img.shape[2] // self.patch_size
+        m = self.merge_size
+        patches = img.unsqueeze(0).reshape(
+            1,
+            channel,
+            gh // m,
+            m,
+            self.patch_size,
+            gw // m,
+            m,
+            self.patch_size,
+        )
+        patches = patches.permute(0, 2, 5, 3, 6, 1, 4, 7)  # (1, gh', gw', m, m, C, P, P)
+        patches = patches.unsqueeze(6).expand(
+            -1, -1, -1, -1, -1, -1, self.temporal_patch_size, -1, -1
+        )  # (1, gh', gw', m, m, C, T, P, P)
+        flatten = patches.reshape(
+            1, gh * gw, channel * self.temporal_patch_size * self.patch_size * self.patch_size
+        )[0]
+        return flatten, [1, gh, gw]
+
+    def _expand_image_tokens(self, input_ids, counts):
+        """Replace each <|image|> placeholder with ``counts[i]`` copies."""
+        image_token_id = self.mm_tokens.image_token_id
+        if image_token_id is None:
+            raise ValueError("image placeholder token id is not set for this processor")
+
+        mask = input_ids == image_token_id
+        num_placeholders = int(mask.sum().item())
+        if num_placeholders != len(counts):
+            raise ValueError(
+                f"prompt has {num_placeholders} image placeholder token(s) but "
+                f"{len(counts)} image(s) were provided"
+            )
+
+        expanded = []
+        next_image_idx = 0
+        for token_id in input_ids.tolist():
+            if token_id == image_token_id:
+                expanded.extend([image_token_id] * counts[next_image_idx])
+                next_image_idx += 1
+            else:
+                expanded.append(token_id)
+        return torch.tensor(expanded, dtype=input_ids.dtype)
+
+    def process_mm_data(
+        self, input_text, images=None, videos=None, audios=None, **kwargs
+    ):
+        if not images or videos or audios:
+            return super().process_mm_data(
+                input_text, images=images, videos=videos, audios=audios, **kwargs
+            )
+
+        tokenize_kwargs = {}
+        bos = getattr(self._tokenizer, "bos_token", None)
+        if (
+            bos
+            and self._tokenizer_auto_adds_specials
+            and isinstance(input_text, str)
+            and input_text.startswith(bos)
+        ):
+            tokenize_kwargs["add_special_tokens"] = False
+        input_ids = self._tokenizer(
+            input_text, return_tensors="pt", **tokenize_kwargs
+        ).input_ids.flatten()
+
+        pixel_values = []
+        grids = []
+        counts = []
+        for pil_image in images:
+            pv, grid = self._preprocess_image(pil_image)
+            pixel_values.append(pv)
+            grids.append(grid)
+            counts.append(grid[1] * grid[2] // (self.merge_size**2))
+
+        input_ids = self._expand_image_tokens(input_ids, counts)
+
+        return {
+            "input_ids": input_ids,
+            "attention_mask": torch.ones_like(input_ids),
+            "pixel_values": torch.cat(pixel_values, dim=0),
+            "image_grid_thw": torch.tensor(grids, dtype=torch.long),
+        }
